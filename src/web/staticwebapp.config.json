{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/api/*", "/icons/*", "/*.{js,css,webmanifest,png,jpg,svg,ico}"]
  },
  "mimeTypes": {
    ".webmanifest": "application/manifest+json"
  },
  "globalHeaders": {
    "Cache-Control": "no-cache",
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  }
}
